# Telegram application credentials (from https://my.telegram.org)
# These identify the *application*, not your account. Still keep them private.
TG_API_ID=
TG_API_HASH=

# Optional: StringSession for ephemeral hosts (see docs/login.md)
# WARNING: this string is full account access. Never commit it.
# TG_SESSION=

# Bot channel — RECOMENDADO. Alerta chega no seu Telegram principal enquanto
# a sessão userbot (número secundário) só lê. Crie o bot no @BotFather, mande
# /start para ele, e pegue o chat_id em /getUpdates. Ver README.
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# Optional: sirene Bark para regras com `siren: true`. Instale o app Bark no
# iPhone, permita Alertas Críticos, e copie a key da URL que o app mostra
# (https://api.day.app/<KEY>/...).
# BARK_KEY=

# Optional: webhook (ntfy / Discord / HA)
# WEBHOOK_URL=

# Optional: heartbeat URL (Healthchecks.io / Uptime Kuma) — recommended in production
# HEARTBEAT_URL=
