# Telegram application credentials (from https://my.telegram.org)
# These identify the *application*, not your account. Still keep them private.
TG_API_ID=
TG_API_HASH=

# Optional: StringSession for ephemeral hosts (see docs/login.md — Sprint 4)
# WARNING: this string is full account access. Never commit it.
# TG_SESSION=

# Optional: bot channel (v0.1.1+)
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# Optional: LLM fallback (v0.2+, default off)
# GROQ_API_KEY=

# Optional: heartbeat URL (Healthchecks.io / Uptime Kuma) — recommended in production
# HEARTBEAT_URL=
