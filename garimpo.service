[Unit]
Description=Garimpo deal prospecting daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garimpo
WorkingDirectory=/opt/garimpo
EnvironmentFile=-/opt/garimpo/.env
ExecStart=/opt/garimpo/.venv/bin/garimpo run -c /opt/garimpo/config/config.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
